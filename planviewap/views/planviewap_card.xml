<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="planviewap_card_view_form" model="ir.ui.view">
        <field name="name">planviewap_card_form</field>
        <field name="model">planviewap.card</field>
        <field name="arch" type="xml">
            <form string="Titre">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}' />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="session_id" />
                            <field name="board_id" />
                            <field name="url_card" widget="url" />
                        </group>
                        <group string="Bind">
                            <field name="card_id_pvap" />
                            <field name="enabled_bind" />
                        </group>
                        <group string="Lane information">
                            <field name="lane_root_id" />
                            <field name="lane_parent_id" />
                            <field name="lane_id" />
                        </group>
                        <group string="Information">
                            <field name="card_type_id" />
                            <field name="size" />
                            <field name="entete" />
                            <field name="external_link" />
                            <field name="description" />
                        </group>
                        <group string="Card info">
                            <field name="copied_from_card_pvap" />
                            <field name="assigned_users" />
                            <field name="moved_on" />
                            <field name="version" />
                            <field name="custom_fields" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Detail">
                            <group>
                                <field name="card_details" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="planviewap_card_view_graph" model="ir.ui.view">
        <field name="name">planviewap_card_graph</field>
        <field name="model">planviewap.card</field>
        <field name="arch" type="xml">
            <graph string="Card">
                <field name="name" type="row" />
                <field name="board_id" type="row" />
                <field name="card_id_pvap" type="row" />
                <field name="lane_id" type="row" />
                <field name="session_id" type="row" />
            </graph>
        </field>
    </record>

    <record id="planviewap_card_view_kanban" model="ir.ui.view">
        <field name="name">planviewap_card_kanban</field>
        <field name="model">planviewap.card</field>
        <field name="arch" type="xml">
            <kanban default_group_by="lane_id">
                <field name="name" />
                <field name="board_id" />
                <field name="card_id_pvap" />
                <field name="lane_id" />
                <field name="session_id" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <ul>
                                    <li class="mb4">
                                        <strong>
                                            <field name="name" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="board_id" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="card_id_pvap" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="lane_id" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="session_id" />
                                        </strong>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="planviewap_card_view_pivot" model="ir.ui.view">
        <field name="name">planviewap_card_pivot</field>
        <field name="model">planviewap.card</field>
        <field name="arch" type="xml">
            <pivot string="Card">
                <field name="name" type="row" />
                <field name="board_id" type="row" />
                <field name="card_id_pvap" type="row" />
                <field name="lane_id" type="row" />
                <field name="session_id" type="row" />
            </pivot>
        </field>
    </record>

    <record id="planviewap_card_view_search" model="ir.ui.view">
        <field name="name">planviewap_card_search</field>
        <field name="model">planviewap.card</field>
        <field name="arch" type="xml">
            <search string="Card">
                <!--                <field name="name" filter_domain="['|', ('name','ilike',self), ('lane_parent_name','ilike',self)]" string="Name" />-->
                <field name="name" />
                <field name="lane_root_name" filter_domain="[('lane_root_name','ilike',self)]" />
                <field name="lane_parent_name" />
                <field name="lane_name" />
                <group string="Group By" expand="1">
                    <filter name="lane_id" string="Lane" context="{'group_by':'lane_id'}" />
                    <filter name="board_id" string="Board" context="{'group_by':'board_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="planviewap_card_view_tree" model="ir.ui.view">
        <field name="name">planviewap_card_tree</field>
        <field name="model">planviewap.card</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="board_id" />
                <field name="card_id_pvap" />
                <field name="lane_root_id" />
                <field name="lane_parent_id" />
                <field name="lane_id" />
                <field name="session_id" />
            </tree>
        </field>
    </record>

    <record id="planviewap_card_view_agile_place_card_action_window" model="ir.actions.act_window">
        <field name="name">Card</field>
        <field name="res_model">planviewap.card</field>
        <field name="view_mode">tree,kanban,pivot,graph,form</field>
    </record>
</odoo>
