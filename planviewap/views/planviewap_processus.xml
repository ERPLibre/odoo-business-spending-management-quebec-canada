<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="planviewap_processus_view_form" model="ir.ui.view">
        <field name="name">planviewap_processus_form</field>
        <field name="model">planviewap.processus</field>
        <field name="arch" type="xml">
            <form string="Titre">
                <header>
                    <button name="action_execute_algo" string="Execute" type="object" class="oe_highlight" />
                    <button
                        name="action_execute_send_sms"
                        string="Send SMS"
                        type="object"
                        class="btn-warning"
                        attrs="{'invisible': [('sms_enable', '=', False)]}"
                    />
                    <button name="action_clear_log" string="Clear log" type="object" />
                    <button name="action_clear_log_depend" string="Clear log with depend" type="object" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="description" />
                            <field name="session_id" />
                            <field name="board_id" />
                            <field name="algo_key" />
                            <field name="type_board_depend_ids" widget="many2many_tags" />
                            <field name="is_disabled" />
                            <field name="ignore_run_depend_processus" />
                            <field name="force_sync_before_algo" />
                            <field name="board_enable_temp_delete_cards" />
                        </group>
                        <group string="Search">
                            <field name="type_card" />
                            <field name="lane_root_name" />
                            <field name="lane_parent_name" />
                            <field name="lane_name" />
                            <field name="exclude_lane_name" />
                            <field name="get_all_lane" />
                            <field name="is_root_lane" />
                            <field name="search_lane_required_string" />
                            <field name="lane_extract_algo" />
                            <field name="force_refresh_custom_fields" />
                            <button
                                name="action_debug_show_first_day"
                                string="Debug show first day"
                                type="object"
                                attrs="{'invisible': [('lane_extract_algo', '=', False)]}"
                            />
                            <hr attrs="{'invisible': [('lane_extract_algo', '=', False)]}" />
                            <field
                                name="debug_show_first_day"
                                attrs="{'invisible': [('lane_extract_algo', '=', False)]}"
                            />
                        </group>
                        <group string="Validation">
                            <field name="validation_target_achieved" />
                            <field name="validation_algo" />
                            <field name="validation_location_custom_field_name" />
                            <field name="validation_location_custom_field_expected_value" />
                            <field name="validation_location_expected_associate_type_card_same_lane" />
                            <field name="validation_location_expected_associate_different_size" />
                            <field name="validation_location_expected_associate_target_achieve" />
                        </group>
                        <group string="SMS">
                            <field name="sms_summary_phone" />
                            <field name="sms_message_prefix" />
                            <field name="sms_message_card_meaning" />
                            <field name="sms_detect_card_type_msg_1" />
                            <field name="sms_detect_card_type_msg_2" />
                            <field name="sms_detect_card_type_msg_2_default_name" />
                            <field name="sms_detect_card_type_msg_2_msg" />
                            <field name="sms_detect_card_type_msg_2_filter" />
                            <field name="sms_enable_reverse_contact_msg_2_key" />
                            <field
                                name="sms_reverse_contact_msg_2_key"
                                attrs="{'invisible': [('sms_enable_reverse_contact_msg_2_key', '=', False)]}"
                            />
                            <field name="sms_replace_card_name_to_msg" />
                            <field name="location_type_msg" />
                            <field name="check_double_sms_process_id" />
                        </group>
                        <group string="Rename">
                            <field name="rename_card_pattern" />
                            <field name="rename_week_lane_name_pattern" />
                            <field name="rename_week_lane_name_icon" />
                            <field name="rename_dont_rename_day_with_number" />
                            <field name="algo_rename" />
                        </group>
                        <group string="Copy">
                            <field name="board_copy_to_id" />
                            <field name="copy_to_root_lane" />
                            <field name="copy_to_parent_lane" />
                            <field name="copy_to_sub_lane" />
                            <field name="copy_to_lane" />
                            <field name="copy_is_root_lane" />
                            <field name="clean_before_card_into_copy_to_lane" />
                            <field name="copy_multiple_time" />
                            <field name="validate_copy_lane_number" />
                        </group>
                        <!--                        <group-->
                        <!--                            string="Binding"-->
                        <!--                            attrs="{'invisible': [('algo_key', 'not in', ['bind_create_card', 'bind_delete_card'])]}"-->
                        <!--                        >-->
                        <!--                            <field name="record_id_i" />-->
                        <!--                        </group>-->
                        <group string="Schedule">
                            <field name="delay_in_day" />
                            <field name="get_all_week" />
                            <field name="ignore_weekend" />
                            <field name="force_update_model" />
                        </group>
                        <group string="Create card and new board">
                            <field name="new_board_name" />
                            <field name="type_template_board_id" />
                            <field name="model_fetch_record" />
                            <field name="model_filter_hr_employee_job_type" />
                            <field name="duplicate_multiple_time" />
                            <field name="process_execute_after_ids" widget="many2many_tags" />
                        </group>
                        <group string="Operate lane">
                            <field name="operate_lane_name" />
                            <field name="operate_lane_action" />
                            <field name="operate_lane_ignore_string_lane" />
                        </group>
                    </group>
                    <group string="SMS Services" attrs="{'invisible': [('sms_enable', '=', False)]}">
                        <field name="sms_enable" invisible="True" />
                        <field name="sms_debug" />
                        <field name="sms_unique_number" />
                        <field name="sms_bind_custom_field_phone_number" />
                        <field name="sms_in_test_mode" />
                        <field name="sms_to_number_phone" />
                        <field name="sms_to_country" />
                        <field name="sms_message_to_send" />
                        <!--                            <field name="sms_limit_iteration" />-->
                    </group>
                    <group name="Alert">
                        <group string="System">
                            <field name="alert_wrong_lane_agencement" />
                        </group>
                        <group string="Limitation">
                            <field name="alert_min_size_card_enable" />
                            <field
                                name="alert_min_size_card"
                                attrs="{'invisible': [('alert_min_size_card_enable', '=', False)]}"
                            />
                            <field name="alert_max_size_card_enable" />
                            <field
                                name="alert_max_size_card"
                                attrs="{'invisible': [('alert_max_size_card_enable', '=', False)]}"
                            />
                            <field name="alert_count_card_msg" />
                            <field name="alert_min_count_card_enable" />
                            <field
                                name="alert_min_count_card"
                                attrs="{'invisible': [('alert_min_count_card_enable', '=', False)]}"
                            />
                            <field name="alert_max_count_card_enable" />
                            <field
                                name="alert_max_count_card"
                                attrs="{'invisible': [('alert_max_count_card_enable', '=', False)]}"
                            />
                        </group>
                    </group>
                    <group>
                        <group string="Extract data">
                            <field name="force_update_after_create" />
                            <field name="default_value_model" />
                            <field name="compute_model_fsm_location" />
                            <field name="compute_model_fsm_person" />
                            <!--                            <field name="create_more_field" />-->
                            <!--                            <field name="create_more_field_algo" />-->
                            <field name="model_name" />
                            <field name="ignore_warning_from_name" />
                            <field name="filter_field" />
                        </group>
                        <group string="Extract data bind">
                            <field name="bind_custom_field" />
                            <field name="bind_required_field_list" />
                            <field name="bind_field" />
                            <field name="type_card_bind" />
                        </group>
                    </group>
                    <notebook>
                        <page string="LOG">
                            <group>
                                <field name="log_error_txt" />
                                <field name="log_txt" />
                            </group>
                        </page>
                        <page string="SMS">
                            <group>
                                <field name="sms_history_ids" />
                            </group>
                        </page>
                        <page string="Dependence">
                            <group>
                                <field name="depend_process_ids" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="planviewap_processus_view_graph" model="ir.ui.view">
        <field name="name">planviewap_processus_graph</field>
        <field name="model">planviewap.processus</field>
        <field name="arch" type="xml">
            <graph string="Plan view agile place processus">
                <field name="name" type="row" />
                <field name="algo_key" type="row" />
                <field name="bind_custom_field" type="row" />
                <field name="model_name" type="row" />
                <field name="lane_parent_name" type="row" />
                <field name="lane_root_name" type="row" />
            </graph>
        </field>
    </record>

    <record id="planviewap_processus_view_kanban" model="ir.ui.view">
        <field name="name">planviewap_processus_kanban</field>
        <field name="model">planviewap.processus</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name" />
                <field name="algo_key" />
                <field name="bind_custom_field" />
                <field name="model_name" />
                <field name="lane_parent_name" />
                <field name="lane_root_name" />
                <field name="type_board_depend_ids" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <ul>
                                    <li class="mb4">
                                        <strong>
                                            <field name="name" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>Algorithme:&amp;nbsp;</strong>
                                        <field name="algo_key" />
                                    </li>
                                    <li class="mb4">
                                        <strong>Depend board:&amp;nbsp;</strong>
                                        <field name="type_board_depend_ids" widget="many2many_tags" />
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="planviewap_processus_view_pivot" model="ir.ui.view">
        <field name="name">planviewap_processus_pivot</field>
        <field name="model">planviewap.processus</field>
        <field name="arch" type="xml">
            <pivot string="Plan view agile place processus">
                <field name="name" type="row" />
                <field name="algo_key" type="row" />
                <field name="bind_custom_field" type="row" />
                <field name="model_name" type="row" />
                <field name="lane_parent_name" type="row" />
                <field name="lane_root_name" type="row" />
            </pivot>
        </field>
    </record>

    <record id="planviewap_processus_view_search" model="ir.ui.view">
        <field name="name">planviewap_processus_search</field>
        <field name="model">planviewap.processus</field>
        <field name="arch" type="xml">
            <search string="Plan view agile place processus">
                <field name="name" filter_domain="[('name','ilike',self)]" string="Name" />
                <field name="algo_key" filter_domain="[('algo_key','ilike',self)]" string="Algo Key" />
                <group string="Group By">
                    <filter
                        string="Algorithme key"
                        name="group_algo_key"
                        domain="[]"
                        context="{'group_by':'algo_key'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="planviewap_processus_view_tree" model="ir.ui.view">
        <field name="name">planviewap_processus_tree</field>
        <field name="model">planviewap.processus</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="algo_key" />
                <field name="bind_custom_field" />
                <field name="model_name" />
                <field name="lane_root_name" />
                <field name="lane_parent_name" />
                <field name="type_card" />
            </tree>
        </field>
    </record>

    <act_window
        id="planviewap_processus_view_agile_place_processus_action_window"
        name="View agile place processus"
        res_model="planviewap.processus"
        view_mode="tree,kanban,pivot,graph,form"
        context="{'search_default_group_algo_key': 1}"
    />
</odoo>
