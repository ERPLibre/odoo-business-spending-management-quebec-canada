<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="asana_agendrix_action_log_view_form" model="ir.ui.view">
        <field name="name">asana_agendrix_action_log_form</field>
        <field name="model">asana.agendrix.action.log</field>
        <field name="arch" type="xml">
            <form string="Titre">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group string="Information">
                            <field name="asana_agendrix_id" />
                            <field name="asana_id_target_object" />
                            <field name="asana_id_empotency_key" />
                            <field name="asana_id_action_type" />
                            <field name="asana_id_action" />
                            <field name="asana_app_configuration_json" />
                            <field name="asana_expires_at" />
                            <field name="asana_id_user" />
                            <field name="asana_id_workspace" />
                            <field name="has_different_configuration" />
                            <field name="execution_error" />
                            <field name="execution_error_reason" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="asana_agendrix_action_log_view_graph" model="ir.ui.view">
        <field name="name">asana_agendrix_action_log_graph</field>
        <field name="model">asana.agendrix.action.log</field>
        <field name="arch" type="xml">
            <graph string="Asana agendrix">
                <field name="name" type="row" />
            </graph>
        </field>
    </record>

    <record id="asana_agendrix_action_log_view_kanban" model="ir.ui.view">
        <field name="name">asana_agendrix_action_log_kanban</field>
        <field name="model">asana.agendrix.action.log</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <ul>
                                    <li class="mb4">
                                        <strong>
                                            <field name="name" />
                                        </strong>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="asana_agendrix_action_log_view_pivot" model="ir.ui.view">
        <field name="name">asana_agendrix_action_log_pivot</field>
        <field name="model">asana.agendrix.action.log</field>
        <field name="arch" type="xml">
            <pivot string="Asana agendrix">
                <field name="name" type="row" />
            </pivot>
        </field>
    </record>

    <record id="asana_agendrix_action_log_view_search" model="ir.ui.view">
        <field name="name">asana_agendrix_action_log_search</field>
        <field name="model">asana.agendrix.action.log</field>
        <field name="arch" type="xml">
            <search string="Asana agendrix">
                <field name="asana_id_user" />
                <!--                <filter domain="[('name','!=',False)]" name="name" string="Name" />-->
            </search>
        </field>
    </record>

    <record id="asana_agendrix_action_log_view_tree" model="ir.ui.view">
        <field name="name">asana_agendrix_action_log_tree</field>
        <field name="model">asana.agendrix.action.log</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="has_different_configuration" />
                <field name="execution_error" />
            </tree>
        </field>
    </record>

    <record id="asana_agendrix_action_log_agendrix_action_window" model="ir.actions.act_window">
        <field name="name">Session</field>
        <field name="res_model">asana.agendrix.action.log</field>
        <field name="view_mode">kanban,tree,pivot,graph,form</field>
    </record>
</odoo>
