<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="agendrix_resource_view_form" model="ir.ui.view">
        <field name="name">agendrix_resource_form</field>
        <field name="model">agendrix.resource</field>
        <field name="arch" type="xml">
            <form string="Titre">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group string="Information">
                            <field name="address" />
                            <field name="agendrix_id_no" />
                            <field name="type_job_site" />
                            <field name="agendrix_create_at" />
                            <field name="agendrix_update_at" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="agendrix_resource_view_graph" model="ir.ui.view">
        <field name="name">agendrix_resource_graph</field>
        <field name="model">agendrix.resource</field>
        <field name="arch" type="xml">
            <graph string="Agendrix resource">
                <field name="name" type="row" />
            </graph>
        </field>
    </record>

    <record id="agendrix_resource_view_kanban" model="ir.ui.view">
        <field name="name">agendrix_resource_kanban</field>
        <field name="model">agendrix.resource</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <ul>
                                    <li class="mb4">
                                        <strong>
                                            <field name="name" />
                                        </strong>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="agendrix_resource_view_pivot" model="ir.ui.view">
        <field name="name">agendrix_resource_pivot</field>
        <field name="model">agendrix.resource</field>
        <field name="arch" type="xml">
            <pivot string="Agendrix resource">
                <field name="name" type="row" />
            </pivot>
        </field>
    </record>

    <record id="agendrix_resource_view_search" model="ir.ui.view">
        <field name="name">agendrix_resource_search</field>
        <field name="model">agendrix.resource</field>
        <field name="arch" type="xml">
            <search string="Agendrix resource">
                <filter domain="[('name','!=',False)]" name="name" string="Name" />
            </search>
        </field>
    </record>

    <record id="agendrix_resource_view_tree" model="ir.ui.view">
        <field name="name">agendrix_resource_tree</field>
        <field name="model">agendrix.resource</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="agendrix_resource_resource_action_window" model="ir.actions.act_window">
        <field name="name">Session</field>
        <field name="res_model">agendrix.resource</field>
        <field name="view_mode">kanban,tree,pivot,graph,form</field>
    </record>
</odoo>
