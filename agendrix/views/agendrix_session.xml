<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="agendrix_session_view_form" model="ir.ui.view">
        <field name="name">agendrix_session_form</field>
        <field name="model">agendrix.session</field>
        <field name="arch" type="xml">
            <form string="Titre">
                <!--                <header>-->
                <!--                    <button name="action_test_agendrix" string="Test agendrix" type="object" class="btn-success" />-->
                <!--                </header>-->
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group string="API">
                            <field name="client_id" />
                            <field name="client_secret" password="True" />
                            <field name="access_token" />
                            <field name="refresh_token" />
                        </group>
                        <group string="Other">
                            <field name="project_name" />
                            <field name="production_enabled" />
                            <field name="workspace_name" />
                            <field name="workspace_gid" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="agendrix_session_view_graph" model="ir.ui.view">
        <field name="name">agendrix_session_graph</field>
        <field name="model">agendrix.session</field>
        <field name="arch" type="xml">
            <graph string="Agendrix session">
                <field name="name" type="row" />
            </graph>
        </field>
    </record>

    <record id="agendrix_session_view_kanban" model="ir.ui.view">
        <field name="name">agendrix_session_kanban</field>
        <field name="model">agendrix.session</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <ul>
                                    <li class="mb4">
                                        <strong>
                                            <field name="name" />
                                        </strong>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="agendrix_session_view_pivot" model="ir.ui.view">
        <field name="name">agendrix_session_pivot</field>
        <field name="model">agendrix.session</field>
        <field name="arch" type="xml">
            <pivot string="Agendrix session">
                <field name="name" type="row" />
            </pivot>
        </field>
    </record>

    <record id="agendrix_session_view_search" model="ir.ui.view">
        <field name="name">agendrix_session_search</field>
        <field name="model">agendrix.session</field>
        <field name="arch" type="xml">
            <search string="Agendrix session">
                <filter domain="[('name','!=',False)]" name="name" string="Name" />
            </search>
        </field>
    </record>

    <record id="agendrix_session_view_tree" model="ir.ui.view">
        <field name="name">agendrix_session_tree</field>
        <field name="model">agendrix.session</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="agendrix_session_session_action_window" model="ir.actions.act_window">
        <field name="name">Session</field>
        <field name="res_model">agendrix.session</field>
        <field name="view_mode">kanban,tree,pivot,graph,form</field>
    </record>
</odoo>
