<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="plan_view_agile_place_processus_view_form" model="ir.ui.view">
        <field name="name">plan_view_agile_place_processus_form</field>
        <field name="model">plan.view.agile.place.processus</field>
        <field name="arch" type="xml">
            <form string="Titre">
                <header>
                    <button name="action_execute_algo" string="Execute" type="object" class="oe_highlight" />
                    <button
                        name="action_execute_send_sms"
                        string="Send SMS "
                        type="object"
                        class="btn-warning"
                        attrs="{'invisible': [('sms_enable', '=', False)]}"
                    />
                    <button name="action_clear_log" string="Clear log" type="object" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="description" />
                            <field name="session_id" />
                            <field name="board_id" />
                            <field name="algo_key" />
                            <field name="type_board_depend_ids" widget="many2many_tags" />
                        </group>
                        <group string="Search">
                            <field name="lane_name" />
                            <field name="lane_parent_name" />
                            <field name="lane_root_name" />
                            <!--                            <field name="sub_lane_name" />-->
                            <field name="type_card" />
                            <field name="is_root_lane" />
                        </group>
                        <group string="SMS">
                            <field name="sms_summary_phone" />
                            <field name="sms_message_prefix" />
                            <field name="sms_detect_card_type_msg_1" />
                            <field name="location_type_msg" />
                        </group>
                        <group string="Copy">
                            <field name="copy_from_lane" />
                            <field name="copy_to_lane" />
                            <field name="clean_before_card_from_lane" />
                        </group>
                        <!--                        <group-->
                        <!--                            string="Binding"-->
                        <!--                            attrs="{'invisible': [('algo_key', 'not in', ['bind_create_card', 'bind_delete_card'])]}"-->
                        <!--                        >-->
                        <!--                            <field name="record_id_i" />-->
                        <!--                        </group>-->
                        <group string="Schedule">
                            <field name="fake_regex_lane" />
                            <field name="delay_in_day" />
                            <field name="ignore_weekend" />
                            <field name="force_update_model" />
                        </group>
                        <group string="Extract data">
                            <field name="force_update_after_create" />
                            <field name="default_value_model" />
                            <field name="compute_model_fsm_location" />
                            <field name="compute_model_fsm_person" />
                            <field name="bind_custom_field" />
                            <field name="bind_required_field_list" />
                            <field name="bind_field" />
                            <field name="model_name" />
                            <field name="ignore_warning_from_name" />
                            <field name="filter_field" />
                        </group>
                    </group>
                    <group>
                        <group string="SMS" attrs="{'invisible': [('sms_enable', '=', False)]}">
                            <field name="sms_enable" invisible="True" />
                            <field name="sms_debug" />
                            <field name="sms_in_test_mode" />
                            <field name="sms_to_number_phone" />
                            <field name="sms_to_country" />
                            <field name="sms_message_to_send" />
                            <field name="sms_limit_iteration" />
                        </group>
                    </group>
                    <notebook>
                        <page string="LOG">
                            <group>
                                <field name="log_error_txt" />
                                <field name="log_txt" />
                            </group>
                        </page>
                        <page string="SMS">
                            <group>
                                <field name="sms_history_ids" />
                            </group>
                        </page>
                        <page string="Dependence">
                            <group>
                                <field name="depend_process_ids" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="plan_view_agile_place_processus_view_graph" model="ir.ui.view">
        <field name="name">plan_view_agile_place_processus_graph</field>
        <field name="model">plan.view.agile.place.processus</field>
        <field name="arch" type="xml">
            <graph string="Plan view agile place processus">
                <field name="name" type="row" />
                <field name="algo_key" type="row" />
                <field name="bind_custom_field" type="row" />
                <field name="model_name" type="row" />
                <field name="lane_parent_name" type="row" />
                <field name="lane_root_name" type="row" />
            </graph>
        </field>
    </record>

    <record id="plan_view_agile_place_processus_view_kanban" model="ir.ui.view">
        <field name="name">plan_view_agile_place_processus_kanban</field>
        <field name="model">plan.view.agile.place.processus</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name" />
                <field name="algo_key" />
                <field name="bind_custom_field" />
                <field name="model_name" />
                <field name="lane_parent_name" />
                <field name="lane_root_name" />
                <field name="type_board_depend_ids" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <ul>
                                    <li class="mb4">
                                        <strong>
                                            <field name="name" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>Algorithme:&amp;nbsp;</strong>
                                        <field name="algo_key" />
                                    </li>
                                    <li class="mb4">
                                        <strong>Depend board:&amp;nbsp;</strong>
                                        <field name="type_board_depend_ids" widget="many2many_tags" />
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="plan_view_agile_place_processus_view_pivot" model="ir.ui.view">
        <field name="name">plan_view_agile_place_processus_pivot</field>
        <field name="model">plan.view.agile.place.processus</field>
        <field name="arch" type="xml">
            <pivot string="Plan view agile place processus">
                <field name="name" type="row" />
                <field name="algo_key" type="row" />
                <field name="bind_custom_field" type="row" />
                <field name="model_name" type="row" />
                <field name="lane_parent_name" type="row" />
                <field name="lane_root_name" type="row" />
            </pivot>
        </field>
    </record>

    <record id="plan_view_agile_place_processus_view_search" model="ir.ui.view">
        <field name="name">plan_view_agile_place_processus_search</field>
        <field name="model">plan.view.agile.place.processus</field>
        <field name="arch" type="xml">
            <search string="Plan view agile place processus">
                <filter domain="[('name','!=',False)]" name="name" string="Name" />
                <filter domain="[('algo_key','!=',False)]" name="algo_key" string="Algo Key" />
                <filter domain="[('bind_custom_field','!=',False)]" name="bind_custom_field" string="Bind Field" />
                <filter domain="[('model_name','!=',False)]" name="model_name" string="Model Name" />
                <filter domain="[('lane_parent_name','!=',False)]" name="lane_parent_name" string="Parent Lane Name" />
                <filter domain="[('lane_root_name','!=',False)]" name="lane_root_name" string="Root Lane Name" />
                <group string="Group By">
                    <filter
                        string="Algorithme key"
                        name="group_algo_key"
                        domain="[]"
                        context="{'group_by':'algo_key'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="plan_view_agile_place_processus_view_tree" model="ir.ui.view">
        <field name="name">plan_view_agile_place_processus_tree</field>
        <field name="model">plan.view.agile.place.processus</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="algo_key" />
                <field name="bind_custom_field" />
                <field name="model_name" />
                <field name="lane_root_name" />
                <!--                <field name="sub_lane_name" />-->
                <field name="lane_parent_name" />
                <field name="type_card" />
            </tree>
        </field>
    </record>

    <act_window
        id="plan_view_agile_place_processus_view_agile_place_processus_action_window"
        name="View agile place processus"
        res_model="plan.view.agile.place.processus"
        view_mode="kanban,tree,pivot,graph,form"
        context="{'search_default_group_algo_key': 1}"
    />
</odoo>
